    ],
    "diag-all": [
      "diag_ctl",
      "diag_packs",
      "diag_chunk"
    ]
  },
  "scales": {
    "pocl": {
      "batch": 65536,
      "benchmark_repeats": 3
    },
    "rtx5080": {
      "batch": 1048576,
      "benchmark_repeats": 3
    }
  },
